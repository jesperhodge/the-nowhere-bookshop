# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Hardcover API token, used only by tools/hardcover.mjs, only on your own
# machine, never in the browser. Get one from hardcover.app → account
# settings → Hardcover API. Tokens expire after a year and reset on 1 January.
#
# Treat it like a password: it can read and write your Hardcover account. If
# it ever ends up in a chat window, a screenshot, a commit or a log, generate
# a new one — the old one stays valid until you do.
HARDCOVER_TOKEN=

# Optional: point the tool somewhere else, e.g. the local fixture server.
# HARDCOVER_ENDPOINT=http://127.0.0.1:8123

# Google Books API key, used only by tools/describe.mjs, only on your own
# machine. Get one from console.cloud.google.com → APIs & Services →
# Credentials → API key, with the Books API enabled. 1,000 free requests/day.
# Without this, describe.mjs skips Google Books cleanly and uses only
# Wikipedia + Wikidata — see DESCRIPTIONS-FEASIBILITY.md for why (this
# sandbox's IP is 429'd by Google Books at any pacing, keyed or not).
GOOGLE_BOOKS_KEY=
