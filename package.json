{
  "name": "the-nowhere-bookshop",
  "version": "1.0.0",
  "private": true,
  "description": "A curated 3D bookshop. The site itself needs no install — this only serves /api and enrichment tooling.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "mock": "HARDCOVER_MOCK=1 node server/index.js",
    "qa": "node tools/qa.mjs",
    "enrich": "NODE_USE_ENV_PROXY=1 node tools/hardcover.mjs enrich",
    "harvest": "NODE_USE_ENV_PROXY=1 node tools/harvest.mjs fetch",
    "harvest:enrich": "NODE_USE_ENV_PROXY=1 node tools/harvest.mjs enrich",
    "harvest:isbns": "NODE_USE_ENV_PROXY=1 node tools/harvest.mjs isbns",
    "harvest:shelve": "node tools/harvest.mjs shelve",
    "harvest:report": "node tools/harvest.mjs report",
    "harvest:curated": "NODE_USE_ENV_PROXY=1 node tools/harvest.mjs curated",
    "describe": "NODE_USE_ENV_PROXY=1 node tools/describe.mjs run",
    "describe:apply": "node tools/describe.mjs apply",
    "describe:report": "node tools/describe.mjs report",
    "describe:selftest": "node tools/describe.mjs selftest"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
