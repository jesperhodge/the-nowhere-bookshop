{
  "name": "philosophicaltech",
  "version": "1.0.0",
  "private": true,
  "description": "philosophicaltech.com — a developer homepage and the projects under it. Hand-written HTML/CSS/ES modules, no bundler; Node only serves /bookshop/api and runs tooling.",
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "start": "node bookshop/server/index.js",
    "mock": "HARDCOVER_MOCK=1 node bookshop/server/index.js",
    "qa": "node bookshop/tools/qa.mjs",
    "enrich": "NODE_USE_ENV_PROXY=1 node bookshop/tools/hardcover.mjs enrich",
    "harvest": "NODE_USE_ENV_PROXY=1 node bookshop/tools/harvest.mjs fetch",
    "harvest:enrich": "NODE_USE_ENV_PROXY=1 node bookshop/tools/harvest.mjs enrich",
    "harvest:isbns": "NODE_USE_ENV_PROXY=1 node bookshop/tools/harvest.mjs isbns",
    "harvest:shelve": "node bookshop/tools/harvest.mjs shelve",
    "harvest:report": "node bookshop/tools/harvest.mjs report",
    "harvest:curated": "NODE_USE_ENV_PROXY=1 node bookshop/tools/harvest.mjs curated",
    "describe": "NODE_USE_ENV_PROXY=1 node bookshop/tools/describe.mjs run",
    "describe:apply": "node bookshop/tools/describe.mjs apply",
    "describe:report": "node bookshop/tools/describe.mjs report",
    "describe:selftest": "node bookshop/tools/describe.mjs selftest"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0"
  }
}
