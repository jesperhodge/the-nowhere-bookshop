{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "home/**", "use": "@vercel/static" },
    { "src": "bookshop/index.html", "use": "@vercel/static" },
    { "src": "bookshop/src/**", "use": "@vercel/static" },
    { "src": "bookshop/vendor/**", "use": "@vercel/static" },
    {
      "src": "bookshop/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "{bookshop/data/cache/hardcover.json,bookshop/data/cache/openlibrary.json,bookshop/server/fixtures/**,bookshop/data/lists/**}"
      }
    }
  ],
  "rewrites": [
    { "source": "/bookshop/api/(.*)", "destination": "/bookshop/api" }
  ],
  "headers": [
    {
      "source": "/bookshop/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/bookshop/src/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/home/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/bookshop/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/bookshop/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-LLMDjX7Ud3auaku1RMPtDieubSx/lAAbhb8I0zPHCzg=' https://www.google.com https://books.google.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-src https://www.google.com https://books.google.com; frame-ancestors 'none'"
        },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
