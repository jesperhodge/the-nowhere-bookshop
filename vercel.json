{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "home/**", "use": "@vercel/static" },
    { "src": "bookshop/index.html", "use": "@vercel/static" },
    { "src": "bookshop/src/**", "use": "@vercel/static" },
    { "src": "bookshop/vendor/**", "use": "@vercel/static" },
    {
      "src": "bookshop/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "{bookshop/data/cache/hardcover.json,bookshop/data/cache/openlibrary.json,bookshop/server/fixtures/**,bookshop/data/lists/**}"
      }
    }
  ],
  "rewrites": [
    { "source": "/bookshop/api/(.*)", "destination": "/bookshop/api" }
  ],
  "headers": [
    {
      "source": "/bookshop/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/bookshop/src/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/home/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/bookshop/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/bookshop/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
