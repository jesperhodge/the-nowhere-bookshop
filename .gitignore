node_modules/
parcel.png
tools/qa-report.json
tools/suggestions/

# Credentials. Order matters here: the negation has to come after the
# pattern it is carving an exception out of, or .env.example gets ignored
# too and nobody can see what needs filling in.
.env
.env.*
!.env.example

# Phase 9's harvest. Appended, not merged into anything above — this file is
# LAST-MATCH-WINS and sorting it silently ignores .env.example. See the note
# on the credentials block.
#
# data/lists/*.json IS the harvest snapshot and is committed: parsed entries
# plus the page, the revision id and a per-table parse audit. The raw
# wikitext underneath it is 4.1 MB for 72 pages and is NOT — every list
# carries a permalink (?oldid=<revid>) that resolves to the byte-identical
# page for good, so provenance does not depend on keeping a local copy.
# Regenerate with:  npm run harvest -- --force   (~72 requests, under a minute)
data/cache/wiki/
# handoff file between `harvest shelve` and `harvest isbns`, rewritten by both
data/cache/isbn-wanted.json

# Phase 11's backfill (tools/describe.mjs). Same split as data/cache/wiki/
# above: the raw per-book Google Books / Wikipedia / Wikidata responses under
# data/cache/describe/ are regenerable from the URL alone and are NOT
# committed. data/cache/describe.json — the derived record of what was
# accepted, rejected and why, per book — IS committed, on the same footing as
# openlibrary.json and harvest-attempts.json.
data/cache/describe/
